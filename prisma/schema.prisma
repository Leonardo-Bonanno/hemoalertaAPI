generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Hemocentro {
  id                    Int     @id @default(autoincrement())
  nome                  String
  cidade                String
  estado                String
  endereco              String
  horario_funcionamento String
  latitude              Decimal @db.Decimal(9, 6)
  longitude             Decimal @db.Decimal(9, 6)
  alerts                Alert[]
}

model BloodType {
  id         Int     @id @default(autoincrement())
  blood_type String
  alerts     Alert[]
}

model Alert {
  id            Int        @id @default(autoincrement())
  blood_type_id Int
  hemocentro_id Int
  created_at    DateTime   @default(now())
  status        String?
  bloodType     BloodType  @relation(fields: [blood_type_id], references: [id])
  hemocentro    Hemocentro @relation(fields: [hemocentro_id], references: [id])
}
